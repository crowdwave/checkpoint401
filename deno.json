{
  "lock": { "path": "./deno.lock", "frozen": true },
  "tasks": {
    "check": "deno check checkpoint401.ts config/*.ts",
    "lint": "deno lint checkpoint401.ts config/*.ts",
    "cache": "deno install --entrypoint checkpoint401.ts config/*.ts"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix",
        "no-control-regex"
      ]
    }
  }
}
