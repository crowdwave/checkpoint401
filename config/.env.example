# Copy to config/.env and fill in real values. Never commit config/.env.
# JWT_SECRET must be at least 32 bytes (256 bits) for HS256. This
# placeholder is deliberately too short: the server refuses to start
# until you replace it. Generate one with, for example:
#   openssl rand -base64 48
JWT_SECRET=CHANGE-ME
DATABASE_URL=postgres://user:password@127.0.0.1:5432/dbname
